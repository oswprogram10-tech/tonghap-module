{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "놀이 카드",
  "description": "칠판 모드의 놀이 룰렛에 쓰는 놀이 목록. 초등 1~2학년 대상.",
  "type": "object",
  "additionalProperties": false,
  "required": ["dataVersion", "plays"],
  "properties": {
    "$schema": { "type": "string" },
    "dataVersion": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "plays": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "place", "group", "minutes", "rules", "safety", "materials", "tags", "topicBookIds"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "name": { "type": "string", "minLength": 1, "maxLength": 20 },
          "place": { "enum": ["outdoor", "indoor", "both"], "description": "실외(운동장)·실내(교실)·둘 다" },
          "group": { "enum": ["whole", "teams", "pairs", "small"], "description": "학급 전체·팀 대항·짝·모둠" },
          "minutes": { "type": "integer", "minimum": 5, "maximum": 40, "description": "한 판에 걸리는 대략적인 시간" },
          "rules": { "type": "array", "minItems": 2, "maxItems": 5, "items": { "type": "string", "minLength": 2, "maxLength": 40 }, "description": "칠판에 크게 보여 줄 규칙. 한 줄에 행동 하나" },
          "safety": { "type": "array", "minItems": 1, "maxItems": 3, "items": { "type": "string", "minLength": 2, "maxLength": 30 } },
          "materials": { "type": "array", "items": { "type": "string", "maxLength": 20 }, "description": "필요한 준비물. 없으면 빈 배열" },
          "tags": { "type": "array", "items": { "enum": ["전래", "신체", "협동", "표현", "규칙", "조용한"] }, "minItems": 1 },
          "topicBookIds": { "type": "array", "items": { "type": "string", "pattern": "^g[12]s[12]-[a-z0-9-]+$" }, "description": "특히 어울리는 주제책. 없으면 빈 배열" }
        }
      }
    }
  }
}
