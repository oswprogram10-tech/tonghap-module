{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "행동특성 및 종합의견 언어 모델 프롬프트",
  "description": "로컬 언어 모델 행동특성 및 종합의견 생성기의 프롬프트와 예시(설계 24). 코드에는 한국어 프롬프트를 두지 않고 이 파일에 둔다.",
  "type": "object",
  "additionalProperties": false,
  "required": ["dataVersion", "system", "user", "examples"],
  "$defs": {
    "sentence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "evidence"],
      "properties": {
        "text": { "type": "string", "minLength": 15, "maxLength": 200 },
        "evidence": { "type": "array", "minItems": 1, "maxItems": 3, "items": { "type": "string", "minLength": 3 } }
      }
    },
    "sentences": { "type": "array", "minItems": 2, "maxItems": 8, "items": { "$ref": "#/$defs/sentence" } },
    "evidence": {
      "type": "object",
      "required": ["kind", "id"],
      "properties": {
        "kind": { "enum": ["observation", "habit"] },
        "id": { "type": "string", "pattern": "^[oh]:[A-Za-z0-9_-]+$" },
        "negative": { "const": true },
        "pair": { "type": "string", "pattern": "^o:[A-Za-z0-9_-]+$" }
      }
    }
  },
  "properties": {
    "$schema": { "type": "string" },
    "dataVersion": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "note": { "type": "string" },
    "system": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "headings", "rules", "styles", "length", "output"],
      "properties": {
        "role": { "type": "string", "minLength": 10 },
        "headings": {
          "type": "object",
          "additionalProperties": false,
          "required": ["rules", "style", "length", "output"],
          "properties": {
            "rules": { "type": "string", "minLength": 1 },
            "style": { "type": "string", "minLength": 1 },
            "length": { "type": "string", "minLength": 1 },
            "output": { "type": "string", "minLength": 1 }
          }
        },
        "rules": { "type": "array", "minItems": 4, "maxItems": 16, "items": { "type": "string", "minLength": 5 } },
        "styles": {
          "type": "object",
          "additionalProperties": false,
          "required": ["ham", "eum", "boim"],
          "properties": { "ham": { "type": "string" }, "eum": { "type": "string" }, "boim": { "type": "string" } }
        },
        "length": { "type": "string", "description": "{target}, {min}, {max}가 들어 있어야 한다" },
        "output": { "type": "string" }
      }
    },
    "user": { "type": "string", "description": "{bundle}이 들어 있어야 한다" },
    "examples": {
      "type": "array",
      "minItems": 2,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "bundle", "outputs"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "note": { "type": "string" },
          "bundle": {
            "type": "object",
            "required": ["student", "subject", "period", "evidence", "standardsText"],
            "properties": {
              "student": { "type": "object", "required": ["alias"], "properties": { "alias": { "const": "학생" } } },
              "subject": { "const": "행" },
              "period": { "type": "object", "required": ["from", "to"] },
              "evidence": { "type": "array", "minItems": 3, "maxItems": 14, "items": { "$ref": "#/$defs/evidence" } },
              "standardsText": { "type": "object", "maxProperties": 0 }
            }
          },
          "outputs": {
            "type": "object",
            "additionalProperties": false,
            "required": ["ham", "eum", "boim"],
            "properties": {
              "ham": { "$ref": "#/$defs/sentences" },
              "eum": { "$ref": "#/$defs/sentences" },
              "boim": { "$ref": "#/$defs/sentences" }
            }
          }
        }
      }
    }
  }
}
