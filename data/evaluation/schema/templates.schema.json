{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "평어 템플릿",
  "description": "평어 초안 템플릿 생성기의 문장 틀. {E}는 문체별 종결로 바뀌고, {슬롯} 또는 {슬롯|을/를} 꼴로 값을 넣는다.",
  "type": "object",
  "additionalProperties": false,
  "required": ["dataVersion", "endings", "tagGroups", "templates"],
  "properties": {
    "$schema": { "type": "string" },
    "dataVersion": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "note": { "type": "string" },
    "endings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ham", "eum", "boim"],
      "properties": {
        "ham": { "type": "string", "minLength": 1, "maxLength": 20, "description": "~함" },
        "eum": { "type": "string", "minLength": 1, "maxLength": 20, "description": "~음 (하였음)" },
        "boim": { "type": "string", "minLength": 1, "maxLength": 20, "description": "~하는 모습을 보임" }
      }
    },
    "tagGroups": {
      "type": "object",
      "additionalProperties": false,
      "required": ["바", "슬", "즐"],
      "description": "교과별 활동 태그 -> 템플릿 묶음 이름",
      "patternProperties": {
        "^[바슬즐]$": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "type": "string", "pattern": "^[a-z][a-z-]*$" }
        }
      }
    },
    "templates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "subject", "group", "text"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "kind": { "enum": ["observation", "habit", "session"] },
          "subject": { "enum": ["바", "슬", "즐"] },
          "group": { "type": "string", "pattern": "^[a-z][a-z-]*$", "description": "관찰: 태그 묶음 또는 general. 습관: high|mid|low. 차시: default" },
          "text": { "type": "string", "minLength": 8, "maxLength": 120, "description": "끝에 {E}가 한 번 있어야 한다" }
        }
      }
    }
  }
}
