{
  "name": "tonghap-module",
  "private": true,
  "version": "0.9.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "validate:data": "node scripts/validate-curriculum.mjs && node scripts/validate-plays.mjs && node scripts/validate-evaluation.mjs && node scripts/validate-synthetic.mjs && node scripts/validate-activities.mjs",
    "tauri": "tauri",
    "fetch:engines": "node scripts/fetch-engines.mjs",
    "test": "node --experimental-strip-types --no-warnings=ExperimentalWarning --test ml/synth/generate-bundles.test.mjs src/board/random.test.mjs src/stt/wav.test.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@tauri-apps/plugin-opener": "^2.7.2",
    "html-to-image": "1.11.13",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "ajv": "^8.20.0",
    "typescript": "^5.9.3",
    "vite": "^8.0.0"
  }
}
